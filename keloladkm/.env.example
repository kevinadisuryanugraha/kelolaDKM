# ── KelolaDKM Frontend Environment ──
# Copy: cp .env.example .env

# Backend Laravel API URL
VITE_API_URL=http://localhost:8000/api

# Demo mode: allow the frontend to run without a backend (mock data).
# Development automatically enables it; for production builds set this explicitly.
VITE_DEMO_MODE=false

# Midtrans (isi dengan client key dari dashboard Midtrans)
VITE_MIDTRANS_CLIENT_KEY=

# Google Maps (isi dengan API key dari Google Cloud Console)
VITE_GOOGLE_MAPS_KEY=
